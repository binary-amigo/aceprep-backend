# Copy to .env for local development. Never commit the real .env.

# MongoDB Atlas connection string (with a freshly rotated password)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mockInterviewQuestions

# Long random string used to sign login tokens:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Same OAuth client ID the frontend uses for the Google button
GOOGLE_CLIENT_ID=536203429777-qvvtvk1rd6qie6coee68645gadov8f8r.apps.googleusercontent.com

# Frontend origins allowed to call the API (comma-separated, * = wildcard part)
CORS_ORIGINS=https://aceprep-phi.vercel.app,https://aceprep-*-imran-khans-projects-bb3f275b.vercel.app

# Google AI (Gemini) key, if/when AI interview routes use it
GEMINI_API_KEY=

PORT=3000
